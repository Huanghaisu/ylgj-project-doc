    </row>
    <row r="30">
      <c r="B30" s="314" t="inlineStr"><is><t>风险区间判断</t></is></c>
      <c r="C30" s="315"><f>IF(E7&lt;E24,&quot;合同物流企业执行边界区&quot;,IF(E13&lt;=0,&quot;承运执行层自担区&quot;,&quot;正常执行区&quot;))</f><v>正常执行区</v></c>
      <c r="D30" s="317"/>
      <c r="E30" s="315"><f>IF(D30=&quot;&quot;,C30,D30)</f><v>正常执行区</v></c>
      <c r="F30" s="316" t="inlineStr"><is><t>文本</t></is></c>
      <c r="G30" s="317" t="inlineStr"><is><t>先保合同物流企业刚性支出，再由承运侧承担执行层波动。</t></is></c>
    </row>
    <row r="31">
      <c r="B31" s="314" t="inlineStr"><is><t>覆盖校验</t></is></c>
